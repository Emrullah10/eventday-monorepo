# Shared across services (each service also has its own .env in services/*)
NODE_ENV=development

# Postgres (one DB, shared by all services in this phase)
DATABASE_URL=postgres://user:password@localhost:5432/everyday

# Redis (service discovery)
REDIS_URL=redis://localhost:6379

# Auth — lives ONLY in the gateway
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=1d
COOKIE_SECRET=your_cookie_signing_secret

# AI aggregator
GEMINI_API_KEY=your_gemini_api_key

# Service ports
GATEWAY_PORT=5000
IDENTITY_PORT=5001
EVENT_PORT=5002
BOOKING_PORT=5003
AGGREGATOR_PORT=5004

# Internal service URLs (used by the gateway to proxy, and services to call each other)
IDENTITY_SERVICE_URL=http://localhost:5001
EVENT_SERVICE_URL=http://localhost:5002
BOOKING_SERVICE_URL=http://localhost:5003
AGGREGATOR_SERVICE_URL=http://localhost:5004
